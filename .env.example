NODE_ENV=development
PORT=3000
API_PREFIX=api
DATABASE_URL=postgresql://credible:credible@localhost:5432/credible
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
MFA_ENABLED=true
PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=128
PASSWORD_HISTORY_SIZE=5
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
MAX_ACTIVE_SESSIONS=5
SESSION_IDLE_TIMEOUT_SECONDS=1800
PRIVILEGED_IDLE_TIMEOUT_SECONDS=900
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
PRIVILEGED_ABSOLUTE_TIMEOUT_SECONDS=28800
VERIFICATION_TOKEN_TTL_SECONDS=900
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
# Optional legacy role policy. Leave empty: users opt in from Settings after signing in.
MFA_REQUIRED_ROLES=
MFA_FACTORS=passkey,totp
ACCESS_TOKEN_SECRET=replace-with-a-managed-secret-at-least-32-characters
ACCESS_TOKEN_ISSUER=credible-api
ACCESS_TOKEN_AUDIENCE=credible-client
ACCESS_TOKEN_KEY_ID=access-key-v1
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
MFA_ENCRYPTION_KEY=credible-mfa-key-32-bytes-long!!
MFA_CHALLENGE_TTL_SECONDS=300
PASSWORD_BLOCKLIST_REDIS_KEY=credible:security:password-blocklist
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Credible <noreply@example.com>
FRONTEND_URL=http://localhost:5173
SWAGGER_ENABLED=true
